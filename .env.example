# Copy this file to .env.local for development, or set these as
# environment variables in your hosting provider (Vercel project settings).
# Nothing in this repo reads .env directly except Next.js itself.

# ─── Public (browser-visible) ────────────────────────────────────────
# The deployed URL — used in OG share previews, sitemap, and canonical tags.
NEXT_PUBLIC_SITE_URL=https://sav.example.com

# The wa.me / WhatsApp link shown to people right after they join the waitlist.
# Get yours at https://wa.me — just append the country code + number.
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/2348012345678

# ─── Server-only (waitlist storage) ──────────────────────────────────
# When you're ready to capture signups, fill these in and uncomment the
# Supabase block at the top of src/app/actions.ts.
#
# 1) Apply the SQL in supabase/sav_waitlist.sql (SQL Editor → New query → Run)
# 2) Project Settings → API → copy the service_role key below.
#    The service_role key is SECRET — never commit it, never expose to the browser.
SUPABASE_URL=https://wmuxpcqjhaxbqtphazot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-KEY
